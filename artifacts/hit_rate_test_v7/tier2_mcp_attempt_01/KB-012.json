  "top_candidate_id": "0b5f5cf6-d4bc-42e9-afcf-73173c428a68",
  "candidates": [
    {
      "knowledge_id": "0b5f5cf6-d4bc-42e9-afcf-73173c428a68",
      "passage_id": "820fa23d66d52741921972289983318c",
      "title": "中电信桂-2025-505号-关于印发中国电信广西公司重要决策法律合规审核管理办法的通知--0b5f5cf6",
      "score": 0.8214999999999999,
      "final_relevance_score": 0.4715,
      "text": "【文档】中电信桂-2025-505号-关于印发中国电信广西公司重要决策法律合规审核管理办法的通知--0b5f5cf6\n【章节】（九）知识产权发展规划以及重大知识产权转让事项 ； > （十）其他对公司经营管理有重大影响的决策事项 。 > 第四条 重要决策作出之前 ，应当进行法律合规审核 。\n定本办法。\n第二条 本办法所称法律合规审核，是指公司法律工作人员\n或外聘律师，根据国家政策法律法规、政府规范性文件和公司规\n章制度，对公司经营管理中涉及的重要决策进行法律分析、开展\n合法合规性论证，提出法律意见、建议或解决方案（以下统称“法\n律意见”）的活动。\n第三条 本办法所称重要决策是指对企业生存发展有重大\n影响，列入党委研究决策重大事项清单中需要经过法律审核的经\n营管理决策，具体包括：\n（一）重大对外投融资、资本运作事项；\n（二）重大资产重组、资产处置等事项；\n（三）重大对外担保事项；\n（四）企业民主管理、职工分流安置等涉及职工权益方面的\n重要事项；\n— 3 — （五）涉及职工重大切身利益方面的重要事项 ；\n（六）合并、分立、解散或变更公司形式的方案 ；\n（七）各级分支机构的设立 、合并或撤销 ；\n（八）代管子公司的合并 、分立或重组 ；\n（九）知识产权发展规划以及重大知识产权转让事项 ；\n（十）其他对公司经营管理有重大影响的决策事项 。"
    },
    {
      "knowledge_id": "917d55a9-10b9-41da-8199-1cab744a757a",
      "passage_id": "075edb407add95be60b42f1ec5ddc48e",
      "title": "中电信桂-2021-405号-关于印发中国电信广西公司业务外包管理办法-修订-的通知--917d55a9",
      "score": 0.5523,
      "final_relevance_score": 0.3523,
      "text": "【文档】中电信桂-2021-405号-关于印发中国电信广西公司业务外包管理办法-修订-的通知--917d55a9\n【章节】第二章 管理职责 > 第五条 区公司企业发展部（法律部）作为公司业务外包统 > 第六条 区公司市场部主要负责组织制定前端相关业务外包\n\n（三）集约化原则：区公司专业部门是本专业条线的业务外\n包管理工作的责任主体，应本着能集约完成的工作均集约处理的\n原则，合理分配事权，减少下放事项。\n（四）合规化原则：实施业务外包要加强合规管理，在外包\n价格标准、外包商采购、外包合作、监督检查等方面加强合规管\n理，防范风险。\n第四条 本办法适用于各市分公司、各专业公司、区公司各\n部门（以下简称“各单位”）。\n第二章 管理职责\n第五条 区公司企业发展部（法律部）作为公司业务外包统\n筹协调部门，统筹协调业务外包管理的相关事项，主要负责公司\n业务外包制度制定、业务外包协议法律审核、法律风险和合规风\n险防范、法律服务支撑等工作。\n第六条 区公司市场部主要负责组织制定前端相关业务外包\n管理规范，负责协调前端业务外包相关事项，会同人力资源部、\n财务部（财务共享服务中心）对前端相关业务外包需求（包括但\n不限于业务需求、人员需求、成本需求）进行管理，负责前端相\n关业务外包框架协议业务审核，负责市场经营业务外包风险防\n范。"
    },
